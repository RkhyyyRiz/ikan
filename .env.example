# URL situs. Dev: http://localhost:3000 | Produksi: URL .vercel.app atau domain sendiri
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya dipakai di server (jangan diberi awalan NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Gambar QRIS statis (URL publik, mis. dari bucket fish-photos)
NEXT_PUBLIC_QRIS_IMAGE_URL=https://xxxxxxxx.supabase.co/storage/v1/object/public/fish-photos/qris.png
# Pisahkan baris dengan \n
NEXT_PUBLIC_PAYMENT_ACCOUNT_INFO=Bank BRI 1234-01-000000-00-0\nA.n. Budi Daya Ikan Kalbar
